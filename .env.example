# EvoluiPC Environment Variables
# Use este arquivo como base para desenvolvimento local.
# Em produção no Render, configure as variáveis diretamente no painel.

# Neo4j Configuration
NEO4J_PASSWORD=seu_password_forte_aqui

# Django Configuration
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Origens liberadas para o frontend local e para o container do frontend.
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://frontend:4173

# Neo4j Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Engine API
ENGINE_API_BASE=http://engine:8002
ENGINE_PORT=8002

# Render (Production)
# RENDER_DEPLOY_KEY=seu_render_key_aqui
# RENDER_PROJECT_ID=seu_project_id_aqui
